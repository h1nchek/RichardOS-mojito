@@ -0,0 +1,25 @@
+<?xml version="1.0" encoding="utf-8"?>
+<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
+
+    <PreferenceCategory
+        android:key="richardos_appearance"
+        android:title="@string/richardos_category_appearance">
+        <Preference
+            android:key="richardos_monet"
+            android:title="@string/richardos_monet_title"
+            android:summary="@string/richardos_monet_summary"
+            android:selectable="false" />
+    </PreferenceCategory>
+
+    <PreferenceCategory
+        android:key="richardos_system"
+        android:title="@string/richardos_category_system">
+        <Preference
+            android:key="richardos_statusbar"
+            android:title="@string/richardos_statusbar_title"
+            android:summary="@string/richardos_statusbar_summary"
+            android:selectable="false" />
+        <Preference
+            android:key="richardos_root"
+            android:title="@string/richardos_root_title"
+            android:summary="@string/richardos_root_summary"
+            android:selectable="false" />
+        <Preference
+            android:key="richardos_lockscreen"
+            android:title="@string/richardos_lockscreen_title"
+            android:summary="@string/richardos_lockscreen_summary"
+            android:selectable="false" />
+    </PreferenceCategory>
+</PreferenceScreen>
