From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: RichardOS <dev@richardos.local>
Date: Thu, 12 Nov 2026 16:00:00 +0000
Subject: [PATCH] Settings: add native RichardOS dashboard entry

Target: LineageOS/android_packages_apps_Settings, lineage-24.0

This patch adds RichardOS as a native dashboard inside the existing Settings
application. It does not create a separate APK or application package.

---
 res/xml/top_level_settings.xml                 |  8 ++++++++
 res/xml/richardos_dashboard.xml                | 25 +++++++++++++++++++++++++
 res/values/richardos_strings.xml               |  9 +++++++++
 src/com/android/settings/richardos/RichardOSDashboardFragment.java | 55 +++++++++++++++++++++++++++++
 5 files changed, 107 insertions(+)
 create mode 100644 res/drawable/ic_richardos_lion.xml
 create mode 100644 res/xml/richardos_dashboard.xml
 create mode 100644 res/values/richardos_strings.xml
 create mode 100644 src/com/android/settings/richardos/RichardOSDashboardFragment.java

diff --git a/res/xml/top_level_settings.xml b/res/xml/top_level_settings.xml
index 93f4c9fa963499f92b3a0f984459394b50bfc081..0000000000000000000000000000000000000000 100644
--- a/res/xml/top_level_settings.xml
+++ b/res/xml/top_level_settings.xml
@@ -1,6 +1,14 @@
 <PreferenceScreen
     xmlns:android="http://schemas.android.com/apk/res/android"
     xmlns:settings="http://schemas.android.com/apk/res-auto"
     android:key="top_level_settings">
+
+    <com.android.settings.widget.HomepagePreference
+        android:fragment="com.android.settings.richardos.RichardOSDashboardFragment"
+        android:icon="@drawable/ic_richardos_lion"
+        android:key="top_level_richardos"
+        android:order="-125"
+        android:title="@string/richardos_title"
+        android:summary="@string/richardos_summary" />
 
     <PreferenceCategory
         android:order="-140"
diff --git a/res/drawable/ic_richardos_lion.xml b/res/drawable/ic_richardos_lion.xml
new file mode 100644
index 0000000000000000000000000000000000000000
--- /dev/null
+++ b/res/drawable/ic_richardos_lion.xml
@@ -0,0 +1,8 @@
+<?xml version="1.0" encoding="utf-8"?>
+<vector xmlns:android="http://schemas.android.com/apk/res/android"
+    android:width="24dp"
+    android:height="24dp"
+    android:viewportWidth="512"
+    android:viewportHeight="512">
+    <path android:fillColor="#F5BE35" android:fillType="evenOdd"
+        android:pathData="M257.22 318.88l-3.26.41-27.77 14.29-2.04 4.9v8.16l1.23 5.31 5.31 11.43 4.9 6.53 1.63-6.53 3.26-4.9 4.5 12.66L256 389.1l8.98-13.47 3.68-7.35 3.26-9.8 3.68 6.13 1.22 5.3 4.9-6.53 3.27-6.12 3.27-10.62v-7.35l-2.05-5.71z" />
+</vector>
+
+diff --git a/res/xml/richardos_dashboard.xml b/res/xml/richardos_dashboard.xml
new file mode 100644
index 0000000000000000000000000000000000000000
--- /dev/null
+++ b/res/xml/richardos_dashboard.xml
@@ -0,0 +1,25 @@
+<?xml version="1.0" encoding="utf-8"?>
+<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
+
+    <PreferenceCategory
+        android:key="richardos_appearance"
+        android:title="@string/richardos_category_appearance">
+        <Preference
+            android:key="richardos_monet"
+            android:title="@string/richardos_monet_title"
+            android:summary="@string/richardos_monet_summary"
+            android:selectable="false" />
+    </PreferenceCategory>
+
+    <PreferenceCategory
+        android:key="richardos_system"
+        android:title="@string/richardos_category_system">
+        <Preference
+            android:key="richardos_statusbar"
+            android:title="@string/richardos_statusbar_title"
+            android:summary="@string/richardos_statusbar_summary"
+            android:selectable="false" />
+        <Preference
+            android:key="richardos_root"
+            android:title="@string/richardos_root_title"
+            android:summary="@string/richardos_root_summary"
+            android:selectable="false" />
+        <Preference
+            android:key="richardos_lockscreen"
+            android:title="@string/richardos_lockscreen_title"
+            android:summary="@string/richardos_lockscreen_summary"
+            android:selectable="false" />
+    </PreferenceCategory>
+</PreferenceScreen>
diff --git a/res/values/richardos_strings.xml b/res/values/richardos_strings.xml
new file mode 100644
index 0000000000000000000000000000000000000000
--- /dev/null
+++ b/res/values/richardos_strings.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="richardos_title">RichardOS</string>
+    <string name="richardos_summary">Your Android. Your rules.</string>
+    <string name="richardos_category_appearance">Appearance</string>
+    <string name="richardos_category_system">System customization</string>
+    <string name="richardos_monet_title">Monet &amp; Themes</string>
+    <string name="richardos_monet_summary">Dynamic colors and accent palettes — coming soon</string>
+    <string name="richardos_statusbar_title">Status Bar &amp; Quick Settings</string>
+    <string name="richardos_statusbar_summary">Status bar and Quick Settings options — coming soon</string>
+    <string name="richardos_root_title">Root &amp; System</string>
+    <string name="richardos_root_summary">Read-only system diagnostics — coming soon</string>
+    <string name="richardos_lockscreen_title">Lock Screen</string>
+    <string name="richardos_lockscreen_summary">Clock and privacy options — coming soon</string>
+</resources>
diff --git a/src/com/android/settings/richardos/RichardOSDashboardFragment.java b/src/com/android/settings/richardos/RichardOSDashboardFragment.java
new file mode 100644
index 0000000000000000000000000000000000000000
--- /dev/null
+++ b/src/com/android/settings/richardos/RichardOSDashboardFragment.java
@@ -0,0 +1,55 @@
