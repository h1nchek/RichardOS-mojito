From 1d8d4f5b545dc7846574bb6437b0528e3f4e1bbe Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Thu, 12 Mar 2026 00:27:03 +0000
Subject: [PATCH] bionic: fall back from epoll_pwait2 on older kernels

Source: cawilliamson/treble_restlessos, android-17.0
Upstream commit: 1d8d4f5b545dc7846574bb6437b0528e3f4e1bbe
License/provenance: RestlessOS repository declares its patch/build system Apache-2.0;
the original author and source are retained here for attribution.

The epoll_pwait2 syscall is unavailable on Linux kernels older than 5.11.
On ENOSYS, fall back to epoll_pwait. Validate timespec values, round positive
sub-millisecond values up, and saturate large timeouts to INT_MAX.

---
 libc/bionic/sys_epoll.cpp | 19 +++++++++++++++++--
 1 file changed, 17 insertions(+), 2 deletion(-)

diff --git a/libc/bionic/sys_epoll.cpp b/libc/bionic/sys_epoll.cpp
index be97818..d3d841e 100644
--- a/libc/bionic/sys_epoll.cpp
+++ b/libc/bionic/sys_epoll.cpp
@@ -80,7 +80,23 @@ int epoll_pwait2_64(int fd, epoll_event* events, int max_events, const timespec*
     kts_ptr = &kts;
   }
 #endif
-  return __epoll_pwait2(fd, events, max_events, kts_ptr, ss, sizeof(*ss));
+  int result = __epoll_pwait2(fd, events, max_events, kts_ptr, ss, sizeof(*ss));
+  if (result == -1 && errno == ENOSYS) {
+    int timeout_ms = -1;
+    if (timeout) {
+      if (timeout->tv_sec < 0 || timeout->tv_nsec < 0 || timeout->tv_nsec >= 1000000000) {
+        errno = EINVAL;
+        return -1;
+      }
+      const long long timeout_ms_64 = timeout->tv_sec > 2147483
+                                          ? 2147483647LL
+                                          : static_cast<long long>(timeout->tv_sec) * 1000 +
+                                                (timeout->tv_nsec + 999999) / 1000000;
+      timeout_ms = timeout_ms_64 > 2147483647LL ? 2147483647 : static_cast<int>(timeout_ms_64);
+    }
+    result = __epoll_pwait(fd, events, max_events, timeout_ms, ss, sizeof(*ss));
+  }
+  return result;
 }
 
 int epoll_wait(int fd, struct epoll_event* events, int max_events, int timeout) {
