From 94e266b8789904d1426de1122887f7f574d709c1 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Fri, 10 Apr 2026 12:00:00 +0100
Subject: [PATCH] MediaProfiles: fall back to defaults when XML cannot be opened

Source: cawilliamson/treble_restlessos, android-17.0
Original upstream change: 94e266b8789904d1426de1122887f7f574d709c1

A media_profiles XML file can pass stat() but still fail fopen().
Return a recoverable failure and let getInstance() use built-in defaults.

---
 media/libmedia/MediaProfiles.cpp | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/media/libmedia/MediaProfiles.cpp b/media/libmedia/MediaProfiles.cpp
--- a/media/libmedia/MediaProfiles.cpp
+++ b/media/libmedia/MediaProfiles.cpp
@@ -1004,4 +1004,9 @@
         } else {
             sInstance = createInstanceFromXmlFile(value);
         }
+        if (sInstance == NULL) {
+            ALOGW("Failed to create media profiles from XML. "
+                    "Using the default instance instead.");
+            sInstance = createDefaultInstance();
+        }
         CHECK(sInstance != NULL);
         sInstance->checkAndAddRequiredProfilesIfNecessary();
@@ -1254,4 +1259,7 @@
 MediaProfiles::createInstanceFromXmlFile(const char *xml)
 {
-    FILE *fp = NULL;
-    CHECK((fp = fopen(xml, "r")));
+    FILE *fp = fopen(xml, "r");
+    if (fp == NULL) {
+        ALOGE("failed to open media profiles file '%s'", xml);
+        return NULL;
+    }
 
     XML_Parser parser = ::XML_ParserCreate(NULL);
-- 
2.56.0
